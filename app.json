{
  "expo": {
    "name": "خطى",
    "slug": "khuta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/khutaIcon.png",
    "scheme": "khutaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/khutaIcon.png",
        "backgroundImage": "./assets/images/khutaIcon.png",
        "monochromeImage": "./assets/images/khutaIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dooom.khutaapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "295c4a0a-2d15-47b9-be69-cae91ee59e45"
      }
    }
  }
}
